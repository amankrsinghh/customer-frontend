# ============================================================================
# Chahat Customized Dresses — Environment Variables (.env)
# Copy this file to `.env` (in BOTH customer-frontend and admin-panel) and
# fill in real values. Restart `npm run dev` after editing.
# ============================================================================

# --- Firebase (Authentication + Firestore) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google Sheets webhook (Apps Script deployment URL) ---
VITE_SHEETS_WEBHOOK_URL=

# --- Razorpay (leave blank to keep mock checkout) ---
VITE_RAZORPAY_KEY_ID=
